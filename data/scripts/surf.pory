raw`
EventScript_UseSurf::
	goto_if_unset FLAG_HIDE_ARCHEOPS, EventScript_EndUseSurf
    call EventScript_UseSurf_Archeops
	dofieldeffect FLDEFF_USE_SURF
EventScript_ReleaseUseSurf::
	releaseall
EventScript_EndUseSurf::
	end

EventScript_CurrentTooFast::
	lockall
	checkfieldmove FIELD_MOVE_SURF
	goto_if_eq VAR_RESULT, FALSE, EventScript_CurrentTooFastEndMsg
	playse SE_SELECT
	msgbox Text_CurrentTooFast
EventScript_CurrentTooFastEndMsg::
	releaseall
	end
`

script EventScript_UseSurf_Archeops {
    getobjectfacingdirection(LOCALID_PLAYER, VAR_RESULT)
    switch (var(VAR_RESULT))
    {
        case DIR_NORTH:
            applymovement(LOCALID_PLAYER, moves(walk_up))
        case DIR_SOUTH:
            applymovement(LOCALID_PLAYER, moves(walk_down))
        case DIR_EAST:
            applymovement(LOCALID_PLAYER, moves(walk_right))
        case DIR_WEST:
            applymovement(LOCALID_PLAYER, moves(walk_left))
    }
    waitmovement(0)
}
