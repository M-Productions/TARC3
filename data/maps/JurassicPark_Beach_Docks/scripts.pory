mapscripts JurassicPark_Beach_Docks_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_GAME_STATE, GS_INTRO {
            setvar(VAR_GAME_STATE, GS_WOKEN_UP)
            goto(JurassicPark_Beach_Docks_EventScript_LarvestaWakeUp)
        }
    ]
}

script JurassicPark_Beach_Docks_EventScript_LarvestaWakeUp {
    mnmbox("(.{PAUSE 20}.{PAUSE 20}.)\p…W-what-", localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
    closemessage
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark, delay_16))
    waitse
    waitmovement(0)
    mnmbox(format("(I- I'm alive!)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    closemessage
    applymovement(LOCALID_PLAYER, moves(face_right, delay_16, face_left, delay_16, face_down))
    waitmovement(0)
    mnmbox(format("(But…\nWhere am I…?)\p(I better go look for the others.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SAD)
    closemessage
    releaseall
    end
}


movement JurassicPark_Beach_Docks_Movement_CameraPanOverDocks {
    walk_down * 4
}

movement JurassicPark_Beach_Docks_Movement_CameraPanFromDocks {
    walk_up * 5
}

script General_EventScript_Cutout
{
    lock
    if(flag(FLAG_TEMP_1))
    {
        msgbox(
            "(Yep, still cardboard.)$"
        )
    }
    else
    {
        msgbox(
            "(As you approach the hut,\n"
            "you start to notice…)\p"
            "(That this is just a cardboard cutout.)$"
        )
        setflag(FLAG_TEMP_1)
    }
    release
    end
}

script JurassicPark_Beach_Docks_EventScript_Meet_Bagon
{
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_BAGON_BEACH, moves(emote_exclamation_mark, delay_16, walk_down*2))
    waitmovement(0)
    mnmbox(format("Larvy!\nYou're okay!"), localId=LOCALID_BAGON_BEACH, mugshotEmotion=MUGSHOT_EMOTE_JOYOUS)
    mnmbox(format("(I'm glad to see you too, Bagon.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    mnmbox(format("That was quite the storm, wasn't it?\N"
    "We all made it out, but the ship's…\p"
    "Well, what's done is done.\N"
    "What matters is that we're all safe!\p"
    "Listen, the others have gone ahead.\p"
    "Let's go meet up with them!"
    ), localId=LOCALID_BAGON_BEACH, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    addvar(VAR_BEACH_CHARACTERS_MET, 1)
    setfollowernpc(LOCALID_BAGON_BEACH, FOLLOWER_NPC_FLAG_ALL_LAND)
    releaseall
    end

}

script JurassicPark_Beach_Docks_EventScript_Bagon
{
    lockall
    faceplayer
    if(var(VAR_GAME_STATE) == GS_FOREST_ROAD)
    {
        mnmbox(format("Let's look around a bit more, Larvy."), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    }
    else
    {
        mnmbox(format("Let's meet up with the others, Larvy."), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)

    }
    closemessage
    release
    end
}

script JurassicPark_Beach_EventScript_MetEveryone
{
    mnmbox(format("(Okay, I've talked to everyone.)\p(I should also go and check what's ahead.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    setvar(VAR_GAME_STATE, GS_MET_EVERYONE)
    release
    end
}


script JurassicPark_Beach_Docks_EventScript_Jigglypuff
{
    lockall
    faceplayer
    mnmbox(format("Well, well, well.\pIf it isn't the consequences of our hubris.\pI hate to tell you that I told you so, but…"), localId=LOCALID_JIGGLYPUFF_BEACH, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Do… You?"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("(Somehow, I doubt it…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format(
        "Aaaanyway!\n"
        "Quite the island we got here, eh?\p"
        "I get a feeling that it's not quite…\n"
        "Deserted.\p"
        "But that could be a good thing.\p"
        "With our vessel destroyed, we might have to hitch a ride from someone.\p"
        "And hopefully, there'll be souvenirs we can take back.\p"
        "Would not want to return empty-handed after all this trouble."),
        localId=LOCALID_JIGGLYPUFF_BEACH, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
        closemessage
        getobjectfacingdirection(LOCALID_PLAYER, VAR_RESULT)
        if(var(VAR_RESULT) == DIR_EAST)
        {
            applymovement(LOCALID_PLAYER, moves(walk_down, face_up))
            applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_down, face_up))
            waitmovement(0)
        }
        applymovement(LOCALID_JIGGLYPUFF_BEACH, moves(walk_left*2, walk_up*10))
        waitmovement(0)
        removeobject(LOCALID_JIGGLYPUFF_BEACH)
        addvar(VAR_BEACH_CHARACTERS_MET, 1)
        goto_if_eq(VAR_BEACH_CHARACTERS_MET, 3, JurassicPark_Beach_EventScript_MetEveryone)
        releaseall
        end
}

script JurassicPark_Beach_EventScript_GoBack
{
    lock
    msgbox(format("(I should meet up with everyone else first.)"))
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_down))
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_down))
    waitmovement(0)
    release
    end
}

script JurassicPark_Beach_Docks_EventScript_Phanpy
{
    lockall
    mnmbox(format("Larvy, my ship…\nIt's completely wrecked…"), localId=LOCALID_PHANPY_BEACH, mugshotEmotion=MUGSHOT_EMOTE_TEARY_EYED)
    mnmbox(format("(It's, uh…\nGood to see you too, Phanpy…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("Phanpy, it'll be ok!\pIf we find treasure, we can buy you a new one!"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    mnmbox(format("Sniffle…\nYou're right."), localId=LOCALID_PHANPY_BEACH, mugshotEmotion = MUGSHOT_EMOTE_TEARY_EYED)
    mnmbox(format(
        "Anyway…\nAbout this island.\p"
        "According to the map, it's known as Isla Nublar.\p"
        "But…\nSomething is not quite right.\p"
        "Everyone I asked told me that this place should be deserted.\p"
        "But as you can see, we're standing on a pier.\NIt's pretty well made, too.\p"
        "This could mean that there's an undocumented civilization living here, or…"
        ), localId=LOCALID_PHANPY_BEACH, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("(That someone got here before us…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Whatever the case, we need to find how to get back home.\pI'll be scouting what's ahead."), localId=LOCALID_PHANPY_BEACH, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    getobjectfacingdirection(LOCALID_PLAYER, VAR_RESULT)
    if(var(VAR_RESULT) == DIR_SOUTH)
        {
            applymovement(LOCALID_PLAYER, moves(walk_right, face_left))
            applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_right, face_left))
            waitmovement(0)
        }
    applymovement(LOCALID_PHANPY_BEACH, moves(walk_up*10))
    waitmovement(0)
    removeobject(LOCALID_PHANPY_BEACH)
    addvar(VAR_BEACH_CHARACTERS_MET, 1)
    goto_if_eq(VAR_BEACH_CHARACTERS_MET, 3, JurassicPark_Beach_EventScript_MetEveryone)
    releaseall
    end

}
