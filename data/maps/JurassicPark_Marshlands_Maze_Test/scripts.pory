mapscripts JurassicPark_Marshlands_Maze_Test_MapScripts {
    MAP_SCRIPT_ON_LOAD
    {
        callnative(RestoreMarshPuzzleBarriers)
    }
}

script JurassicPark_Marshlands_Maze_Armaldo
{
    msgbox(format("PLACEHOLDER\pBattle in which you need to make the Armaldo fall asleep."))
    closemessage
}

script JurassicPark_Marshlands_Generator
{
    if(var(VAR_MARSH_STATE) == 3)
    {
        mnmbox(format("Splendid.\nWe found a generator.\pShould be easy enough to restart.\nJust press the button, aaaand-"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
        closemessage
        playse(SE_M_STRENGTH)
        setvar(VAR_0x8004, 1)  // vertical pan
	    setvar(VAR_0x8005, 1)  // horizontal pan
	    setvar(VAR_0x8006, 20) // num shakes
	    setvar(VAR_0x8007, 5)  // shake delay
        special(ShakeCamera)
        waitstate
        clearflag(FLAG_HIDE_ARMALDO)
        mnmbox(format("Uh, what was that…?\p…Let's get out of here as quickly as we can."), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
        closemessage
        switch(var(VAR_GAME_STATE))
        {
            case GS_NO_GENERATORS:
                setvar(VAR_GAME_STATE, GS_ONE_GENERATOR)
                setvar(VAR_FIRST_SAVED, CHAR_JIGGLYPUFF)
            case GS_POST_ONE_GENERATOR:
                setvar(VAR_GAME_STATE, GS_TWO_GENERATORS)
                setvar(VAR_SECOND_SAVED, CHAR_JIGGLYPUFF)
            case GS_POST_TWO_GENERATORS:
                setvar(VAR_GAME_STATE, GS_THREE_GENERATORS)
                setvar(VAR_THIRD_SAVED, CHAR_JIGGLYPUFF)
        }
        setvar(VAR_MARSH_STATE, 4)
        setvar(VAR_MARSH_COMPLETE, 1)
    }
    end
}

script JurassicPark_Marshlands_EventScript_ArmaldoFinal
{
    playmoncry(SPECIES_ARMALDO, CRY_MODE_NORMAL)
    waitmoncry
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_HIDE_ARMALDO)
}