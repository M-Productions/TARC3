script JurassicPark_Road_To_Visitor_Centre_EventScript_Sign
{
    lock
    msgbox(format("{UP_ARROW} Ancient Desert\n{DOWN_ARROW} Primordial Beach\l{LEFT_ARROW} Lost Mountains\l{RIGHT_ARROW}Observation Platform, Forgotten Swamp, Laboratory"), MSGBOX_SIGN)
    release
    end
}

script JurassicPark_Visitor_Centre_EventScript_GoingAfterDrampa
{
    lock
    mnmbox(format("Look, Larvy!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    closemessage
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_down))
    waitmovement(0)
    applymovement(LOCALID_CAMERA, moves(walk_down*3))
    applymovement(LOCALID_DRAMPA_FOREST, moves(walk_fast_right*8))
    waitmovement(LOCALID_DRAMPA_FOREST)
    removeobject(LOCALID_DRAMPA_FOREST)
    applymovement(LOCALID_CAMERA, moves(walk_up*4))
    waitmovement(0)
    special(RemoveCameraObject)
    mnmbox(format("Let's go after him!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_down*2))
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_down*2))
    waitmovement(0)
    setfollowernpc(LOCALID_PHANPY_FOREST, FOLLOWER_NPC_FLAG_ALL_LAND)
    setvar(VAR_GAME_STATE, GS_HEADING_TOWARDS_LAB)
    releaseall
    end
}

