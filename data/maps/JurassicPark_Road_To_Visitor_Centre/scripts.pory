mapscripts JurassicPark_Road_To_Visitor_Centre_MapScripts {
    MAP_SCRIPT_ON_TRANSITION
    {
        if(var(VAR_GAME_STATE) == GS_FOREST_ROAD)
        {
            setobjectxyperm(LOCALID_JIGGLYPUFF_FOREST, 21, 34)
            setobjectxyperm(LOCALID_PHANPY_FOREST, 42, 36)
        }
        if(var(VAR_GAME_STATE) == GS_PRE_MEETING_DRAMPA)
        {
            setobjectxyperm(LOCALID_JIGGLYPUFF_FOREST, 31, 13)
            setobjectxyperm(LOCALID_PHANPY_FOREST, 32, 13)
        }
        if(var(VAR_GAME_STATE) == GS_CENTRE_GOING_AFTER_DRAMPA)
        {
            clearflag(FLAG_HIDE_PHANPY_FOREST)
            clearflag(FLAG_HIDE_DRAMPA_FOREST)
            setobjectxyperm(LOCALID_PHANPY_FOREST, 32, 8)
            setobjectxyperm(LOCALID_DRAMPA_FOREST, 35, 16)
            setobjectmovementtype(LOCALID_PHANPY_FOREST, MOVEMENT_TYPE_FACE_DOWN)
            setobjectmovementtype(LOCALID_DRAMPA_FOREST, MOVEMENT_TYPE_FACE_RIGHT)
        }
        if(var(VAR_GAME_STATE) == GS_CENTRE_AFTER_BRIDGE)
        {
            
            clearflag(FLAG_HIDE_PHANPY_FOREST)
            setobjectxyperm(LOCALID_PHANPY_FOREST, 51, 17)
            setobjectxy(LOCALID_PHANPY_FOREST, 51, 17)
            setobjectmovementtype(LOCALID_PHANPY_FOREST, MOVEMENT_TYPE_FACE_LEFT)
            addobject(LOCALID_PHANPY_FOREST)
            clearflag(FLAG_HIDE_JIGGLYPUFF_FOREST)
            setobjectxyperm(LOCALID_JIGGLYPUFF_FOREST, 46, 16)
            setobjectxy(LOCALID_JIGGLYPUFF_FOREST, 46, 16)
            setobjectmovementtype(LOCALID_JIGGLYPUFF_FOREST, MOVEMENT_TYPE_FACE_LEFT)
            addobject(LOCALID_JIGGLYPUFF_FOREST)
            clearflag(FLAG_HIDE_BAGON_FOREST)
            setobjectxy(LOCALID_BAGON_FOREST, 45, 16)
            setobjectxyperm(LOCALID_BAGON_FOREST, 45, 16)
            setobjectmovementtype(LOCALID_BAGON_FOREST, MOVEMENT_TYPE_FACE_RIGHT)
            addobject(LOCALID_BAGON_FOREST)
            clearflag(FLAG_HIDE_TYRANTRUM_FOREST)
            addobject(LOCALID_TYRANTRUM_FOREST)

        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_GAME_STATE, GS_CENTRE_GOING_AFTER_DRAMPA {
            goto(JurassicPark_Visitor_Centre_EventScript_GoingAfterDrampa)
        }
        VAR_GAME_STATE, GS_CENTRE_AFTER_BRIDGE {
            goto(JurassicPark_Visitor_Centre_EventScript_TyrantrumScene)
        }
    ]
}


script JurassicPark_Road_To_Visitor_Centre_EventScript_PlayerObserveForest {
    lockall
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    setvar(VAR_GAME_STATE, GS_FOREST_ROAD)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, Common_Movement_ExclamationMark)
    waitmovement(0)
    mnmbox(format("Hey, guys!\nWhat's-"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Shh!\nLook!"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    mnmbox(format("Look at w…\nOh!"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    closemessage
    playbgm(MUS_JURASSIC_PARK_MAIN_THEME, TRUE)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, moves(walk_slow_up*10, walk_slow_diag_northeast*12, walk_slow_up*9, walk_slow_diag_northwest*12))
    waitmovement(0)
    delay(32)
    fadescreen(FADE_TO_BLACK)
    teleportcamera(VAR_TEMP_1, VAR_TEMP_2)
    waitmovement(0)
    delay(10)
    fadescreen(FADE_FROM_BLACK)
    special(RemoveCameraObject)
    playbgm(MUS_FOREST_FIELD, TRUE)
    mnmbox(format("It's…\nIt's…\lIt's beautiful!"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    mnmbox(format("It really is."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(face_down))
    applymovement(LOCALID_PHANPY_FOREST, moves(face_down))
    waitmovement(0)
    mnmbox(format("And would you look at that.\NThere ARE other Pokémon here."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("They look weird, though."), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Hey, that's a bit rude!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("Well, it's true.\NNever seen any Pokémon that look like this, that's for sure.\pHopefully they're not a cannibal tribe."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("C-cannibals?!"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("Jiggly!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("Gee, sensitive much?\nIt'll be fine.\pC'mon, let's go talk to them."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    closemessage
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(walk_up*4))
    waitmovement(0)
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_up*4))
    waitmovement(0)
    setobjectxy(LOCALID_JIGGLYPUFF_FOREST, 21, 34)
    setobjectxy(LOCALID_PHANPY_FOREST, 42, 36)
    setobjectxyperm(LOCALID_JIGGLYPUFF_FOREST, 21, 34)
    setobjectxyperm(LOCALID_PHANPY_FOREST, 42, 36)
    releaseall
    end


}

movement JurassicPark_Road_To_Visitor_Centre_Movement_PlayerWalkToForest {
    walk_up * 5
}

script JurassicPark_Road_To_Visitor_Centre_EventScript_DrampaStartTutorial {
    playse(SE_M_SNORE)
    mnmboxdelay
    playse(SE_M_SNORE)
    mnmboxdelay
    callnative(StartPuzzleTutorialBattle)
    waitstate
    helpwindow(HELP_BATTLE_TUTORIAL)
    mnmbox("You're a very interesting Pokémon,\nwho are you?")
    mnmboxdelay
    mnmbox("Larvesta? What a funny name...\nWell it's a pleasure to meet you.")
}


script JurassicPark_Road_To_Visitor_Centre_EventScript_Jigglypuff
{
    lock
    mnmbox(format("HELLO?\nHELLO{PAUSE 20}O{PAUSE 20}O{PAUSE 20}O{PAUSE 20}O{PAUSE 20}?!"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
    faceplayer
    waitmovement(0)
    mnmbox(format("Get a load of these guys, Larvy.\pI'm trying to ask them something, and they're ignoring me!"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("Maybe it's because they can't understand us?"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("No, it's because we're outsiders, isn't it?\pThis isn't an island of cannibals.\NIt's an island of racists!"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("(I'm not sure that's it, Jiggly.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(face_up))
    waitmovement(0)
    mnmbox(format("HELLO{PAUSE 20}O{PAUSE 20}O{PAUSE 20}O{PAUSE 20}O{PAUSE 20}?!"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
    closemessage
    release
    end
}

script JurassicPark_Road_To_Visitor_Centre_EventScript_Bastiodon
{
    lock
    mnmbox("Guoh?\pTHIS MUGSHOT IS A PLACEHOLDER", localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    release
}

script JurassicPark_Road_To_Visitor_Centre_EventScript_Raging_Bolt
{
    lock
    mnmbox(format("Uhm, hello?\nSir?\lOr madam?\pCan I ask you something?"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_SAD)
    mnmbox("…\pTHIS MUGSHOT IS A PLACEHOLDER", localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Hmm…\nNo response.\pMaybe they can't hear me because their neck is too long."), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_SAD)
    mnmbox("(I wonder…)", localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    closemessage
    end

}

script JurassicPark_Road_To_Visitor_Centre_EventScript_Phanpy
{
    lock
    faceplayer
    if(var(VAR_GAME_STATE) == GS_HEADING_TOWARDS_LAB)
    {
        mnmbox(format("Quick, after him!"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
        release
        end
    }

    if(var(VAR_GAME_STATE) == GS_CENTRE_AFTER_BRIDGE)
    {
        mnmbox(format("…"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
        release
        end
    }


    mnmbox(format("Bagon, Larvy, there's something strange going on.\pDo you see that?"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("Looks like a flying-type Pokémon to me."), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Well, probably, but…\pHave you ever seen a Pokémon that looks like this?"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("No, but…\pThere's a lot of different Pokémon in the world."), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Fair enough.\nBut I HAVE seen a Pokémon like this.\lIn a book.\pIt was a book about…\nPrehistoric Pokémon."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    mnmbox(format("Pre-\nHuh?"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("I'm not completely sure.\nBut…\pIf I am correct, this Pokémon here…\NShould be extinct."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("(What does that mean…?)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("I'm not… Sure what to make of this, exactly.\pAnd I don't remember seeing the long-necked ones in the book.\pI think we should try and find out more."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    closemessage
    release
    end
}

script JurassicPark_Road_To_Visitor_Centre_EventScript_Archen
{
    lock
    faceplayer
    mnmbox(format("Squawk?"), localId=LOCALID_ARCHEN, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    release
    end
}

script JurassicPark_Road_To_Visitor_Centre_EventScript_MeetDrampa
{
    lockall
    setvar(VAR_GAME_STATE, GS_PRE_MEETING_DRAMPA)
    removeobject(LOCALID_PHANPY_FOREST)
    removeobject(LOCALID_JIGGLYPUFF_FOREST)
    setobjectxyperm(LOCALID_PHANPY_FOREST, 45, 27)
    setobjectxyperm(LOCALID_JIGGLYPUFF_FOREST, 46, 27)
    addobject(LOCALID_PHANPY_FOREST)
    addobject(LOCALID_JIGGLYPUFF_FOREST)
    applymovement(LOCALID_PLAYER, moves(face_down))
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(face_down))
    waitmovement(0)
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_up))
    waitmovement(0)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down))
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_up*3))
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(walk_up*4))
    waitmovement(LOCALID_JIGGLYPUFF_FOREST)
    mnmbox("Erm…\nSo what do you guys think…?", localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox("Well, I think that-", localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Jiggly!\nWait!\pWe need to get into proper position first!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    mnmbox(format("Phanpy, we talked about this."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
    mnmbox(format("No!!!\pAccording to the Manual of the Impeccable Explorer…\pImportant team briefings should be delivered standing in formation!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("In the interest of time, I will skip the arguing.\pLet's just do that."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    mnmbox(format("Thank you."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_JOYOUS)
    closemessage
    fadenewbgm(MUS_CALM_CUTSCENE)
    fadescreen(FADE_TO_BLACK)
    delay(5)
    special(RemoveCameraObject)
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    if(var(VAR_TEMP_1) == 44)
    {
        applymovement(LOCALID_PLAYER, moves(walk_faster_right*2))
        waitmovement(0)
    }
    if(var(VAR_TEMP_1) == 45)
    {
        applymovement(LOCALID_PLAYER, moves(walk_faster_right))
        waitmovement(0)
    }
    applymovement(LOCALID_PLAYER, moves(walk_faster_up*5, face_down))
    waitmovement(0)
    setobjectxy(OBJ_EVENT_ID_NPC_FOLLOWER, 46, 18)
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(face_up))
    setobjectxy(LOCALID_JIGGLYPUFF_FOREST, 47, 17)
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(face_left))
    setobjectxy(LOCALID_PHANPY_FOREST, 45, 17)
    applymovement(LOCALID_PHANPY_FOREST, moves(face_right))
    waitmovement(0)
    fadescreen(FADE_FROM_BLACK)
    mnmbox(format("As I was saying…\pI think we're dealing with an uncontacted tribe."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Uncontacted tribe?"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Yeah, y'know.\nCannibals and the such."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Enough with that joke!"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("Quit it, Jiggly."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    mnmbox(format("(He's right, though.\nNot about the cannibals, but…)\p(These Pokémon ARE very strange.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("There's something that bothers me, though.\pI'm pretty sure that at least some of these Pokémon are from the prehistoric era."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("And how would that be possible, smarty pants?\pThey just…\nHid here and survived going extinct?\pAnd if so, who built the stairs?\nThe pier?\lThat strange… Cardboard house?"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("…What's pants?"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("It's something Machoke have.\nDon't ask, it's kinda gross."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    mnmbox(format("Look, I don't know!\nBut…\pThere has to be an explanation!\nThere has to be something here that-"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    playmoncry(SPECIES_DRAMPA, CRY_MODE_NORMAL)
    closemessage
    playmoncry(SPECIES_DRAMPA, CRY_MODE_NORMAL)
    msgbox(format("H{PAUSE 10}O{PAUSE 10}O{PAUSE 10}O{PAUSE 10}O{PAUSE 10}O{PAUSE 10}O{PAUSE 10}NK{PAUSE 10} MI{PAUSE 5}MI{PAUSE 5}MI{PAUSE 5}MI{PAUSE 5}MI."))
    playmoncry(SPECIES_DRAMPA, CRY_MODE_NORMAL)
    msgbox(format("H{PAUSE 10}O{PAUSE 10}O{PAUSE 10}O{PAUSE 10}O{PAUSE 10}O{PAUSE 10}O{PAUSE 10}NK{PAUSE 10} MI{PAUSE 5}MI{PAUSE 5}MI{PAUSE 5}MI{PAUSE 5}MI."))
    mnmbox(format("Did you guys hear that?!"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("Just sounds like someone snoring."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("We should check it out!\nIt could be someone we can talk to!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    closemessage
    applymovement(OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_left*10))
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_left*10))
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(walk_left*10))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_faster_up))
    waitmovement(0)
    destroyfollowernpc
    removeobject(LOCALID_JIGGLYPUFF_FOREST)
    removeobject(LOCALID_PHANPY_FOREST)
    setobjectxyperm(LOCALID_JIGGLYPUFF_FOREST, 31, 13)
    setobjectxyperm(LOCALID_PHANPY_FOREST, 32, 13)
    clearflag(FLAG_HIDE_JIGGLYPUFF_FOREST)
    clearflag(FLAG_HIDE_PHANPY_FOREST)
    addobject(LOCALID_JIGGLYPUFF_FOREST)
    addobject(LOCALID_PHANPY_FOREST)
    fadedefaultbgm
    end
}

script JurassicPark_Road_To_Visitor_Centre_EventScript_GoBackToMeetDrampaWalkNorth
{
    lock
    mnmbox(format("(I have to see what's going on over there first.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    applymovement(LOCALID_PLAYER, moves(walk_up))
    waitmovement(0)
    release
    end
}

script JurassicPark_Road_To_Visitor_Centre_EventScript_GoBackToMeetDrampaWalkWest
{
    lock
    mnmbox(format("(I have to see what's going on over there first.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    applymovement(LOCALID_PLAYER, moves(walk_left))
    waitmovement(0)
    release
    end
}

script JurassicPark_Road_To_Visitor_Centre_Snoring_Drampa
{
    lock
    fadenewbgm(MUS_CUTSCENE_MYSTERIOUS)
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    switch(var(VAR_TEMP_1))
    {
        case 31:
            applymovement(LOCALID_PLAYER, moves(walk_right*2))
            waitmovement(0)
        case 32:
            applymovement(LOCALID_PLAYER, moves(walk_right))
            waitmovement(0)
        case 33:
            break
        case 34:
            applymovement(LOCALID_PLAYER, moves(walk_left))
            waitmovement(0)
        case 35:
            applymovement(LOCALID_PLAYER, moves(walk_left*2))
            waitmovement(0)
    }
    applymovement(LOCALID_PLAYER, moves(walk_up*2, walk_left, face_up))
    waitmovement(0)
    mnmbox(format("That's not a prehistoric Pokémon!\nThat's a Drampa!"), localId=LOCALID_BAGON_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("Maybe they would know something about what's going on."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("You know what they say: sleeping Pokémon tell no tales.\pI'm going to try and wake them up."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Don't you think someone else should do it?"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("It's because I'm a Jigglypuff, isn't it?"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("You'd just make them sleep harder!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    mnmbox(format("Fine, fine.\nLarvy, figure it out."), , localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    mnmbox(format("(If we get them to talk to us, we might learn something about this mysterious island.)\p(Well, here goes nothing!)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    mnmboxdelay
    msgbox(format("Insert battle here"))
    fadenewbgm(MUS_CALM_CUTSCENE)
    helpwindow(HELP_BATTLE_TUTORIAL)
    applymovement(LOCALID_DRAMPA_FOREST, moves(walk_in_place_down))
    mnmbox(format("What the…\pWho are you?!\nHow did you get here?!\lAre you with the tax office?!"), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("Uhm, no.\nWe're treasure hunters.\pWe kind of…\nWrecked our boat."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("Ah!\nTreasure hunters!\lWhat a relief!\pOh, but you came early!\nThe park is not finished yet!"), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_JOYOUS)
    mnmbox(format("Ohh, a park?"), localId=LOCALID_BAGON_FOREST, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    mnmbox(format("And you are…?"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Ah, how rude!\p Dr. John Drampa, at your service."), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Listen, Dr. Drampa…"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Dr. John Drampa."), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    mnmbox(format("Listen, John.\pWhat's going on here?\nWasn't this a deserted island?\pWhat are all these Pokémon doing here?"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("But of course!\nIt's only natural that you would be confused.\pFollow me, I will explain everything."), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    applymovement(LOCALID_DRAMPA_FOREST, moves(walk_up*3))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_DRAMPA_FOREST)
    setflag(FLAG_HIDE_DRAMPA_FOREST)
    waitse
    mnmbox(format("…I really don't like this guy."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    closemessage
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(walk_left, walk_up*2, walk_right, walk_up*3))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_JIGGLYPUFF_FOREST)
    waitse
    mnmbox(format("I've never met a doctor before."), localId=LOCALID_BAGON_FOREST, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    mnmbox(format("I'm very curious what this is all about."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_left))
    waitmovement(0)
    applymovement(LOCALID_BAGON_FOREST, moves(walk_up*4))
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_up*4))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_BAGON_FOREST)
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_up))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_PHANPY_FOREST)
    mnmbox(format("(I suppose I should go check this out, too.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_up*4))
    waitmovement(0)
    playse(SE_EXIT)
    setvar(VAR_GAME_STATE, GS_MET_DRAMPA)
    warp(MAP_JURASSIC_PARK_VISITOR_CENTRE, 10, 19)
}

script JurassicPark_Road_To_Visitor_Centre_Too_Dangerous_Down
{
    lock
    mnmbox(format("Dr. Drampa said wandering around could be dangerous."), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_down))
    waitmovement(0)
    release
    end
}

