script JurassicPark_Visitor_Centre_EventScript_TyrantrumScene
{
    lock
    applymovement(LOCALID_PLAYER, moves(walk_fast_left*5))
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_fast_left*5))
    waitmovement(0)
    applymovement(LOCALID_PHANPY_FOREST, moves(face_up))
    applymovement(LOCALID_PLAYER, moves(face_up))
    applymovement(LOCALID_BAGON_FOREST, moves(face_down))
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(face_down))
    waitmovement(0)
    mnmbox(format("What are you guys doing out here?!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("We're going to repair the generators!"), localId=LOCALID_BAGON_FOREST, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    mnmbox(format("Yeah, I figured out where the generators are.\pTurns out, there's a bridge to the lab, but it retracts when the generators are out as a security measure.\pAnd the only way to take 'em back up is manually."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Forget about it!\nThe cage is broken!\pWe need to hide, now!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("What?!"), localId=LOCALID_BAGON_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    closemessage
    delay(10)
    applymovement(LOCALID_PLAYER, moves(face_down))
    applymovement(LOCALID_PHANPY_FOREST, moves(face_down))
    waitmovement(0)
    playmoncry(SPECIES_TYRANTRUM, CRY_MODE_NORMAL)
    waitmoncry
    mnmbox(format("N-no way…"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    closemessage
    playse(SE_M_STRENGTH)
    applymovement(LOCALID_TYRANTRUM_FOREST, moves(walk_up, delay_16*2))
    waitmovement(0)
    playse(SE_M_STRENGTH)
    applymovement(LOCALID_TYRANTRUM_FOREST, moves(walk_up, delay_16*2))
    waitmovement(0)
    playse(SE_M_STRENGTH)
    applymovement(LOCALID_TYRANTRUM_FOREST, moves(walk_up, delay_16*2))
    waitmovement(0)
    playse(SE_M_STRENGTH)
    applymovement(LOCALID_TYRANTRUM_FOREST, moves(walk_up, delay_16*2))
    playse(SE_M_STRENGTH)
    waitmovement(0)
    playse(SE_M_STRENGTH)
    applymovement(LOCALID_TYRANTRUM_FOREST, moves(walk_up, delay_16*2))
    waitmovement(0)
    mnmbox(format("… … …\nRun."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    closemessage
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(walk_fast_right*10))
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_fast_left*13, walk_fast_up*6, walk_fast_left*13))
    applymovement(LOCALID_BAGON_FOREST, moves(walk_fast_left*12, walk_fast_down*10))
    applymovement(LOCALID_PLAYER, moves(walk_fast_left*13, walk_fast_up*9))
    applymovement(LOCALID_TYRANTRUM_FOREST, moves(walk_up, walk_fast_left*11, walk_up*10))
    waitmovement(LOCALID_PLAYER)
    clearflag(FLAG_ALWAYS_RAINING)
    warp(MAP_JURASSIC_PARK_VISITOR_CENTRE, 10, 19)
    setflag(FLAG_HIDE_BAGON_FOREST)
    setflag(FLAG_HIDE_BAGON_CENTRE)
    setflag(FLAG_HIDE_PHANPY_FOREST)
    setflag(FLAG_HIDE_PHANPY_CENTRE)
    setflag(FLAG_HIDE_JIGGLYPUFF_FOREST)
    setflag(FLAG_HIDE_JIGGLYPUFF_CENTRE)
    setflag(FLAG_HIDE_TYRANTRUM_FOREST)
    setflag(FLAG_HIDE_ARCHEN_FOREST)
    setflag(FLAG_HIDE_DRAMPA_CENTRE)
    setflag(FLAG_HIDE_DINOS_WILDS)
    clearflag(FLAG_SPAWN_WEST)
    waitstate
    
}

script JurassicPark_Road_To_Visitor_Centre_EventScript_GeneratorMountain
{
    setvar(VAR_MOUNTAIN_COMPLETE, 2)
    switch(var(VAR_GAME_STATE))
    {
        case GS_ONE_GENERATOR:
            goto(JurassicPark_Road_To_Visitor_Centre_EventScript_FirstGenBagon)
        case GS_TWO_GENERATORS:
            goto(JurassicPark_Road_To_Visitor_Centre_EventScript_SecondGenBagon)
    }
}




script JurassicPark_Road_To_Visitor_Centre_EventScript_FirstGenBagon
{
    
    mnmbox(format("We almost made it back!\nAnd no scary Pokémon to be found.\pHopefully it stays that way!"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    mnmbox(format("(I do wonder were it went, though.)\p(It couldn't have left the island, but…\NMaybe it really won't bother us again.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Let's go back to the centre."), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    fadescreen(FADE_TO_BLACK)
    destroyfollowernpc
    clearflag(FLAG_HIDE_BAGON_FOREST)
    setflag(FLAG_SPAWN_WEST)
