script JurassicPark_Road_To_Visitor_Centre_Snoring_Drampa
{
    fadenewbgm(MUS_CUTSCENE_MYSTERIOUS)
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    switch(var(VAR_TEMP_1))
    {
        case 31:
            applymovement(LOCALID_PLAYER, moves(walk_right*2))
            waitmovement(0)
        case 32:
            applymovement(LOCALID_PLAYER, moves(walk_right))
            waitmovement(0)
        case 33:
            break
        case 34:
            applymovement(LOCALID_PLAYER, moves(walk_left))
            waitmovement(0)
        case 35:
            applymovement(LOCALID_PLAYER, moves(walk_left*2))
            waitmovement(0)
    }
    applymovement(LOCALID_PLAYER, moves(walk_up*2, walk_left, face_up))
    waitmovement(0)
    mnmbox(format("That's not a prehistoric Pokémon!\nThat's a Drampa!"), localId=LOCALID_BAGON_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("Maybe they would know something about what's going on."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("You know what they say: sleeping Pokémon tell no tales.\pI'm going to try and wake them up."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Don't you think someone else should do it?"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("It's because I'm a Jigglypuff, isn't it?"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("You'd just make them sleep harder!"), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    mnmbox(format("Fine, fine.\nLarvy, figure it out."), , localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    mnmbox(format("(If we get them to talk to us, we might learn something about this mysterious island.)\p(Well, here goes nothing!)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    mnmboxdelay
    puzzlebattle(BP_TUTORIAL)
    waitstate
    fadenewbgm(MUS_CALM_CUTSCENE)
    helpwindow(HELP_BATTLE_TUTORIAL)
    applymovement(LOCALID_DRAMPA_FOREST, moves(walk_in_place_down))
    mnmbox(format("What the…\pWho are you?!\nHow did you get here?!\lAre you with the tax office?!"), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("Uhm, no.\nWe're treasure hunters.\pWe kind of…\nWrecked our boat."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("Ah!\nTreasure hunters!\lWhat a relief!\pOh, but you came early!\nThe park is not finished yet!"), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_JOYOUS)
    mnmbox(format("Ohh, a park?"), localId=LOCALID_BAGON_FOREST, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    mnmbox(format("And you are…?"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Ah, how rude!\p Dr. John Drampa, at your service."), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Listen, Dr. Drampa…"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Dr. John Drampa."), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    mnmbox(format("Listen, John.\pWhat's going on here?\nWasn't this a deserted island?\pWhat are all these Pokémon doing here?"), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("But of course!\nIt's only natural that you would be confused.\pFollow me, I will explain everything."), localId=LOCALID_DRAMPA_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    applymovement(LOCALID_DRAMPA_FOREST, moves(walk_up*3))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_DRAMPA_FOREST)
    setflag(FLAG_HIDE_DRAMPA_FOREST)
    waitse
    mnmbox(format("…I really don't like this guy."), localId=LOCALID_JIGGLYPUFF_FOREST, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    closemessage
    applymovement(LOCALID_JIGGLYPUFF_FOREST, moves(walk_left, walk_up*2, walk_right, walk_up*3))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_JIGGLYPUFF_FOREST)
    waitse
    mnmbox(format("I've never met a doctor before."), localId=LOCALID_BAGON_FOREST, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    mnmbox(format("I'm very curious what this is all about."), localId=LOCALID_PHANPY_FOREST, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_left))
    waitmovement(0)
    applymovement(LOCALID_BAGON_FOREST, moves(walk_up*4))
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_up*4))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_BAGON_FOREST)
    applymovement(LOCALID_PHANPY_FOREST, moves(walk_up))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_PHANPY_FOREST)
    mnmbox(format("(I suppose I should go check this out, too.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_up*4))
    waitmovement(0)
    playse(SE_EXIT)
    setvar(VAR_GAME_STATE, GS_MET_DRAMPA)
    warp(MAP_JURASSIC_PARK_VISITOR_CENTRE, 10, 19)
}

