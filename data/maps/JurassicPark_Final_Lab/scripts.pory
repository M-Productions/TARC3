mapscripts JurassicPark_Final_Lab_MapScripts {
    MAP_SCRIPT_ON_TRANSITION
    {
        switch(var(VAR_THIRD_SAVED))
        {
            case CHAR_BAGON:
                setvar(VAR_LOCALID_CUTSCENE_MAIN, LOCALID_BAGON_LAB)
            case CHAR_PHANPY:
                setvar(VAR_LOCALID_CUTSCENE_MAIN, LOCALID_PHANPY_LAB)
            case CHAR_JIGGLYPUFF:
                setvar(VAR_LOCALID_CUTSCENE_MAIN, LOCALID_JIGGLYPUFF_LAB)
        }
        switch(var(VAR_SECOND_SAVED))
        {
            case CHAR_BAGON:
                setvar(VAR_LOCALID_CUTSCENE_SECOND, LOCALID_BAGON_LAB)
            case CHAR_PHANPY:
                setvar(VAR_LOCALID_CUTSCENE_SECOND, LOCALID_PHANPY_LAB)
            case CHAR_JIGGLYPUFF:
                setvar(VAR_LOCALID_CUTSCENE_SECOND, LOCALID_JIGGLYPUFF_LAB)
        }
        setobjectxy(VAR_LOCALID_CUTSCENE_MAIN, 10, 8)
        setobjectxyperm(VAR_LOCALID_CUTSCENE_MAIN, 10, 8)
        setobjectxy(VAR_LOCALID_CUTSCENE_SECOND, 8, 8)
        setobjectxyperm(VAR_LOCALID_CUTSCENE_SECOND, 8, 8)
        addobject(VAR_LOCALID_CUTSCENE_MAIN)
        addobject(VAR_LOCALID_CUTSCENE_SECOND)
        setweather(WEATHER_NONE)
        doweather
        end
    }
}

script JurassicPark_Final_Lab_EventScript_Drampa_Scene
{
    clearflag(FLAG_DETERMINATION)
    fadenewbgm(MUS_CUTSCENE_MYSTERIOUS)
    applymovement(LOCALID_PLAYER, moves(walk_left, walk_up))
    waitmovement(0)
    switch(var(VAR_LOCALID_CUTSCENE_MAIN))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("…Ah!\nHe's there!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
        case LOCALID_PHANPY_LAB:
            mnmbox(format("…There he is."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SAD)
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("…Well, well, well.\pLook who we have there."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    }
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_up))
    applymovement(VAR_LOCALID_CUTSCENE_MAIN, moves(walk_up))
    applymovement(VAR_LOCALID_CUTSCENE_SECOND, moves(walk_up))
    waitmovement(0)
    switch(var(VAR_LOCALID_CUTSCENE_SECOND))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("H-hey, you!!"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
        case LOCALID_PHANPY_LAB:
            mnmbox(format("Doctor!"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("John Drampa, we meet again."), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    }
    playse(SE_PIN)
    applymovement(LOCALID_DRAMPA_LAB, moves(emote_exclamation_mark, delay_16*2, walk_down))
    waitmovement(0)
    mnmbox(format("You!\nYou're…"), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("You're alive.\pThat's… Good.\nThat's good.\pBut, weren't there four of you?"), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
    mnmbox(format("(… … …)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("…Ah.\nI see.\pRegrettable.\nVery, very, regrettable."), localId=LOCALID_DRAMPA_LAB)
    applymovement(VAR_LOCALID_CUTSCENE_MAIN, moves(walk_up))
    waitmovement(0)
    switch(var(VAR_LOCALID_CUTSCENE_MAIN))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("We won't forgive you for what you did for our friend!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
        case LOCALID_PHANPY_LAB:
            mnmbox(format("Doctor, we won't let you open this park!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("Your little mad science experiment ends now."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    }
    mnmbox(format("…So this is how it is?\pHmm.\nLet me tell you a story."), localId=LOCALID_DRAMPA_BRIDGE, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    closemessage
    applymovement(LOCALID_DRAMPA_LAB, moves(walk_right))
    waitmovement(0)
    mnmbox(format("Have you ever felt like our society was…\nDegenerate?\pRotten to the core?"), localId=LOCALID_JIGGLYPUFF_LAB, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    switch(var(VAR_LOCALID_CUTSCENE_SECOND))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("Not, really…?"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
        case LOCALID_PHANPY_LAB:
            mnmbox(format("What are you even talking about…?"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("Oh, great, here we go."), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    }
    closemessage
    applymovement(LOCALID_DRAMPA_LAB, moves(walk_left, walk_in_place_down))
    waitmovement(0)
    mnmbox(format("…I'm quite serious.\pSociety is heading to its collapse.\pWeak Pokémon rule over weak Pokémon.\pLawlessness and banditism are everywhere.\pEven this…\nTreasure hunting of yours.\pWho is that supposed to benefit?\nSociety?\pNo, I don't think so.\pCommon ruffians, the lot of you."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    mnmbox(format("Hey!"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("(This is quite a strange way to see things…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    closemessage
    applymovement(LOCALID_DRAMPA_LAB, moves(walk_left))
    waitmovement(0)
    mnmbox(format("Of course, with my intellect, I foresaw all of this.\pAnd so I looked to the past.\pYes, at a time before recorded history.\pWhen powerful Pokémon ruled the world.\pThe strong consumed the weak.\pSimple.\nBeautiful.\nEffective.\pBut this wonderful civilisation…\nDid not have a chance to thrive.\pWiped out by a cataclysm.\pQuite unfair, don't you think?\pAnd so I decided…\pTo bring them back."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    closemessage
    applymovement(LOCALID_DRAMPA_LAB, moves(walk_right, walk_in_place_down))
    waitmovement(0)
    mnmbox(format("I spent all my fortunes, and decades of my life, to study genetic engineering.\pAnd finally, the breakthrough.\pI could bring them back, so they could rule again."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    switch(var(VAR_LOCALID_CUTSCENE_MAIN))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("These aren't rulers!\pThese are monsters!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
        case LOCALID_PHANPY_LAB:
            mnmbox(format("…That didn't turn out the way you wanted, did it?"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("Your enlightened rulers have the intelligence of a rock.\pNo offense to rocks."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    }
    mnmbox(format("…Indeed.\nI was confronted with the reality.\pThey were strong, yes.\nStronger than any Pokémon of today.\pBut they were…\nMindless.\pStrength, without wisdom, is nothing.\pI brought back ancient Pokémon after ancient Pokémon, and they were all disappointments.\pEven Tyrantrum, the mighty king of the prehistoric world…\pI will be honest with you.\pWhen I discovered that it possessed no intellect, I was thrown into the deepest despair.\pBut then…"), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_SAD)
    closemessage
    applymovement(LOCALID_DRAMPA_LAB, moves(walk_left))
    waitmovement(0)
    mnmbox(format("I realised how powerful I myself had become.\pI unlocked the secrets of genetic engineering.\pI could…\nCreate my own gods.\pThere were so many avenues to explore!\pCloning.\nSplicing.\lCreation of entirely new lifeforms.\pBut before long, I ran out of money.\pAnd so, I had an idea.\pWhat if I took all my failures, and exhibited them for the world to see…\NFor a price, of course.\pAnd through this, not only will I cover all my fundings…\pBut I will be sure to have access to plenty of…\nTest subjects."), localId=LOCALID_DRAMPA_LAB)
    mnmbox(format("You're insane."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("What did you say about…\pCreating gods?"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    closemessage
    applymovement(LOCALID_DRAMPA_LAB, moves(walk_in_place_down))
    waitmovement(0)
    mnmbox(format("Ah!\nPiqued your interest, didn't I!"), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_JOYOUS)
    closemessage
    applymovement(LOCALID_DRAMPA_LAB, moves(walk_left, walk_in_place_down))
    mnmbox(format("Yes, there were many options I experimented with.\pBut one of them was particularly promising.\pSay, are you familiar with the concept of…\p{COLOR RED}Genetic cross-over?{COLOR DARK_GRAY}"), localId=LOCALID_DRAMPA_LAB)
    switch(var(VAR_LOCALID_CUTSCENE_SECOND))
    {
        
        case LOCALID_BAGON_LAB:
            mnmbox(format("Genetic…\nWhat?!"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
            mnmbox(format("Genetic cross-over.\pThe exchange of genetic material between chromosomes during reproduction."), localId=LOCALID_DRAMPA_LAB)
        
        case LOCALID_PHANPY_LAB:
            mnmbox(format("Isn't that…\pWhat causes babies to be a mix of their parents…?"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
            mnmbox(format("An imprecise definition, but in a nutshell, yes!"), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
        
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("Isn't that like, a sex thing."), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
            mnmbox(format("…In a sense.\pMore accurately, it's the exchange of genetic material between chromosomes during reproduction."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    }
    mnmbox(format("You see, I developed a virus capable of altering the genetic makeup of Pokémon.\pYou take a Pokémon with knowledge, wisdom, and intellect…\pAnd inject them with a retrovirus containing prehistoric DNA.\pThe result is the transformation into a superior lifeform.\pBelieve it or not, much easier than growing one from scratch.\pI call it the cross-over virus.\nOr C.O.V., if you prefer."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    mnmbox(format("Why are you telling us all this…?"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    closemessage
    applymovement(LOCALID_DRAMPA_LAB, moves(walk_right*2, walk_in_place_down))
    waitmovement(0)
    mnmbox(format("…You know, I really was intending on letting you leave.\pThe park needs some good publicity, before its opening.\pBut you've seen too much.\pYou've seen the…\nFlaws.\pI can't let this chance be ruined, you see."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_SAD)
    closemessage
    applymovement(VAR_LOCALID_CUTSCENE_MAIN, moves(walk_up))
    waitmovement(0)
    switch(var(VAR_LOCALID_CUTSCENE_MAIN))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("Are you going to…\nKill us?!"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
        case LOCALID_PHANPY_LAB:
            mnmbox(format("…You're planning to get rid of us."), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("How classic.\pMonologuing before you kill us."), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    }
    mnmbox(format("What?!\pOf course not!\nDo you take me for a common murderer?!"), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("Ahem.\nAs I said, what happened to your friend was an accident.\pA regrettable one, too.\pAnd, good heavens, why would I waste time explaining everything if I was planning to kill you?\pNo, I will just be taking you as my assistants.\pIt's hard to run a park by myself, after all.\pAnd you have proven yourselves to be more than capable to handle the job."), localId=LOCALID_DRAMPA_LAB)
    switch(var(VAR_LOCALID_CUTSCENE_MAIN))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("…Ok, and what if we just refuse?"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
        case LOCALID_PHANPY_LAB:
            mnmbox(format("Assistants?\pI don't think so!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("…Are you stupid?"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    }
    mnmbox(format("Of course, I am perfectly aware that you would not be willing to take this opportunity without some…\pIncentive."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    mnmbox(format("(As if we would do this for any amount of money in the world!)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    mnmbox(format("Money?\nYou seem to misunderstand.\pNo, what I mean is…"), localId=LOCALID_DRAMPA_LAB)
    closemessage
    applymovement(LOCALID_DRAMPA_LAB, moves(walk_down*2))
    waitmovement(0)
    playbgm(MUS_DUMMY, 0)
    playse(SE_M_ABSORB)
    waitse
    mnmbox(format("This."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    switch(var(VAR_LOCALID_CUTSCENE_MAIN))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("Owww!\pA needle?\pWhat…\nWhat was in it…?"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
        case LOCALID_PHANPY_LAB:
            mnmbox(format("Ow!\pWhat was that f-…\pWait…\nDon't tell me, in this needle…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("…Ow!\nHey!\pWhat did you inject me with?!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
    }
    mnmbox(format("The C.O.V., of course."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    closemessage
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark, delay_16))
    applymovement(VAR_LOCALID_CUTSCENE_MAIN, moves(emote_exclamation_mark, delay_16))
    applymovement(VAR_LOCALID_CUTSCENE_SECOND, moves(emote_exclamation_mark, delay_16))
    waitmovement(0)
    mnmbox(format("(No…\pWhat's gonna happen now?!)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("I had to stop my research, but I did manage to get some batches made.\pStill highly experimental, of course.\pYour friend here will transmute into something greater.\pOf course, they won't be the same Pokémon you've known them as.\pNow, theoretically, a vaccine could be made.\pBut only if I'm allowed to continue my research.\pAnd you'll help me, won't you?"), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    switch(var(VAR_LOCALID_CUTSCENE_SECOND))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("Larvy, we need to get out of this island and find help, now!"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)        
        case LOCALID_PHANPY_LAB:
            mnmbox(format("We'll find someone else…\pThat can make the vaccine!"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_PAIN)        
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("You…\nWe'll find someone else that can make a vaccine!"), localId=VAR_LOCALID_CUTSCENE_SECOND, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    }
    mnmbox(format("Leave and I'll destroy my research.\nAll of it.\pI'm deadly serious.\pI spent more than half my life on this.\pMaybe someone will be able to make a vaccine.\pHow long will it take?\nFifty years?\pA century, without my genius?\pSuit yourselves.\nBut I think I know what you will choose."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    switch(var(VAR_LOCALID_CUTSCENE_MAIN))
    {
        case LOCALID_BAGON_LAB:
            mnmbox(format("WAAAAA!\pMAKE IT STOP!\nMAKE IT STOP!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
        case LOCALID_PHANPY_LAB:
            mnmbox(format("WHAT DID YOU DO?!\pTAKE IT BACK!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
        case LOCALID_JIGGLYPUFF_LAB:
            mnmbox(format("GRAAAH!\pHOW DARE YOU STAB ME!\pHOW D-\pGRAHHHH!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
    }
    mnmbox(format("Oh, my.\pPlease, calm yourself down.\pYour mental state does affect the result of the metamorphosis."), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("AAAAAAAH!"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
    mnmbox(format("Settle down, I said!\pIt's going to happen soon!\pYou wouldn't want to…!"), localId=LOCALID_DRAMPA_LAB, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
    closemessage
    special(SpawnCameraObject)
    applymovement(LOCALID_DRAMPA_LAB, moves(lock_facing_direction, walk_up, unlock_facing_direction))
    applymovement(LOCALID_CAMERA, moves(walk_right, walk_up))
    waitmovement(LOCALID_CAMERA)
    dofieldeffectsparkle(10, 7, 0)
	waitfieldeffect(FLDEFF_SPARKLE)
	setvar(VAR_RESULT, 0)
	playbgm(MUS_VS_BOSS_POWERFUL, 0)
	playse(SE_ORB)
	special(DoOrbEffect)
    delay(150)
    switch(var(VAR_LOCALID_CUTSCENE_MAIN))
    {
        case LOCALID_BAGON_LAB:
            removeobject(LOCALID_BAGON_LAB)
            setvar(VAR_LOCALID_CUTSCENE_MAIN, LOCALID_ROARING_MOON_LAB)
        case LOCALID_PHANPY_LAB:
            removeobject(LOCALID_PHANPY_LAB)
            setvar(VAR_LOCALID_CUTSCENE_MAIN, LOCALID_GREAT_TUSK_LAB)
        case LOCALID_JIGGLYPUFF_LAB:
            removeobject(LOCALID_JIGGLYPUFF_LAB)
            setvar(VAR_LOCALID_CUTSCENE_MAIN, LOCALID_SCREAM_TAIL_LAB)
    }
    setobjectxyperm(VAR_LOCALID_CUTSCENE_MAIN, 10, 7)
    addobject(VAR_LOCALID_CUTSCENE_MAIN)
}   