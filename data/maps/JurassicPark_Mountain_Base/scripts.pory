mapscripts JurassicPark_Mountain_Base_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_MOUNTAIN_STATE, 0
        {
            lock
            mnmbox(format("(…Snow?\nThe climate on this island really is strange.)\p(I wonder if it was the Doctor's doing.)\p(Either way, I need to find Bagon.)"), localId=LOCALID_PLAYER)
            closemessage
            applymovement(LOCALID_PLAYER, moves(walk_left*2))
            waitmovement(0)
            setvar(VAR_MOUNTAIN_STATE, 1)
            destroyfollowernpc
            release
            end
        }
    ]
    MAP_SCRIPT_ON_TRANSITION{
        if(var(VAR_MOUNTAIN_STATE) == 7)
        {
            clearflag(FLAG_HIDE_ARCHEOPS_BASE)
            addobject(15)
        }
    }
}

script JurassicPark_Mountain_Base_GoLeft
{
    mnmbox(format("(I still have things to do here.)"))
    applymovement(LOCALID_PLAYER, moves(walk_left))
    waitmovement(0)
}

script JurassicPark_Mountain_Base_EventScript_Archen_1
{
    faceplayer
    if(var(VAR_MOUNTAIN_STATE) == 1)
    {
        nonpuzzlebattle(SPECIES_ARCHEN)
        mnmbox(format("(This Pokémon…\nIt wants me to ride it?)"), localId=LOCALID_PLAYER)
        mnmbox(format("(Wait, I mean-\nNevermind.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
        mnmbox(format("(…Ahem.\nRegardless, I should try giving it a shot.)"), localId=LOCALID_PLAYER)
        closemessage
        setvar(VAR_MOUNTAIN_STATE, 2)
    }
    lockall
    call(JurassicPark_Mountain_Base_EventScript_ArchenSetup)
    if(var(VAR_0x8004) == 17)
    {
        applymovement(VAR_LAST_TALKED, moves(walk_right*7, walk_in_place_right))
        applymovement(LOCALID_PLAYER, moves(walk_right*7, set_visible, walk_right))
        waitmovement(LOCALID_PLAYER)
        setobjectxyperm(VAR_LAST_TALKED, 24, 56)
        setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_RIGHT)
    }
    else
    {
        applymovement(VAR_LAST_TALKED, moves(walk_left*7, walk_in_place_left))
        applymovement(LOCALID_PLAYER, moves(walk_left*7, set_visible, walk_left))
        waitmovement(LOCALID_PLAYER)
        setobjectxyperm(VAR_LAST_TALKED, 17, 56)
        setobjectmovementtype(VAR_LAST_TALKED, MOVEMENT_TYPE_FACE_LEFT)
    }
    releaseall
    end
}
    
