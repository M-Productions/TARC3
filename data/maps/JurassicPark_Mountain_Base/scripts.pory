script JurassicPark_Mountain_Base_EventScript_ArchenSetup
{
    hidefollowernpc
    switch(var(VAR_FACING))
    {
        case DIR_NORTH:
            applymovement(LOCALID_PLAYER, moves(walk_up, set_invisible))
            waitmovement(0)
        case DIR_EAST:
            applymovement(LOCALID_PLAYER, moves(walk_right, set_invisible))
            waitmovement(0)
        case DIR_WEST:
            applymovement(LOCALID_PLAYER, moves(walk_left, set_invisible))
            waitmovement(0)
        case DIR_SOUTH:
            applymovement(LOCALID_PLAYER, moves(walk_down, set_invisible))
            waitmovement(0)
    }
    getplayerxy(VAR_0x8004, VAR_0x8005)
    return
}

script JurassicPark_Mountain_Base_BruteBonnet
{
    if (var(VAR_MOUNTAIN_STATE) < 3)
    {
        mnmbox(format("(Something's growing over there…)\p(Wait… Not just growing… It's moving…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
        closemessage
        end
    }
    faceplayer
    mnmbox(format("(It keeps eyeing Bagon… I need to keep an eye on him…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    puzzlebattle(BP_BRUTE_BONNET)
    waitstate
    closemessage
    removeobject(LOCALID_BRUTE_BONNET)
    forcesave
    release
    end
}

script JurassicPark_Mountain_Base_Bagon
{
    if(var(VAR_MOUNTAIN_STATE) == 2)
    {
        faceplayer
        mnmbox(format("Laaaaaaarvy!\pLarvy Larvy Larvy Larvy Larvy!"), localId=LOCALID_BAGON_MOUNTAIN, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
        mnmbox(format("(…Yes, Bagon?)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
        mnmbox(format("I flew, Larvy!\nI flew on the back of those birds!\pThis place is amazing!"), localId=LOCALID_BAGON_MOUNTAIN, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
        mnmbox(format("…Wait, where's the others?"), localId=LOCALID_BAGON_MOUNTAIN, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
        switch(var(VAR_GAME_STATE))
        {
            case GS_NO_GENERATORS:
                mnmbox(format("(I haven't seen anyone else yet…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
                mnmbox(format("Oh, okay.\nHey, don't worry, Larvy, I'm sure they found a cozy spot to hide in!\pI can't wait to see them and tell them about this place."), localId=LOCALID_BAGON_MOUNTAIN, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
            case GS_POST_ONE_GENERATOR:
                switch(var(VAR_FIRST_SAVED))
                {
                    case CHAR_JIGGLYPUFF:
                        mnmbox(format("(I only managed to find Jiggly so far…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
                        mnmbox(format("Oh, Phanpy's still missing?\pWhen we find her, I bet Jiggly is gonna yell at her for making him worry, hehe."), localId=LOCALID_BAGON_MOUNTAIN, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
                    case CHAR_PHANPY:
                        mnmbox(format("(I only managed to find Phanpy so far…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
                        mnmbox(format("Oh, Jiggly's still missing?\pWhen we find him, I bet he's gonna yell at us for taking too long, hehe."), localId=LOCALID_BAGON_MOUNTAIN, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)                
            case GS_POST_TWO_GENERATORS:
                mnmbox(format("(I can't…\nBring myself to say it…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
                mnmbox(format("…What's wrong Larvy?\nWorried about something?\p…Whatever it it, it'll be okay.\pI wish I had wings like these Pokémon, so I could fly around and save everyone.\pOne day, I will!\nBut for now, we have to do what wew can."), localId=LOCALID_BAGON_MOUNTAIN, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)

            }
        }
        mnmbox(format("Anyway, earlier Jiggly told me that there should be a generator on top of this mountain.\pLet's go find it, so we can go home!"), localId=LOCALID_BAGON_MOUNTAIN, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
        closemessage
        setfollowernpc(LOCALID_BAGON_MOUNTAIN, FOLLOWER_NPC_FLAG_ALL)
        setvar(VAR_MOUNTAIN_STATE, 3)
        end
    }
    else
    {
        mnmbox(format("Let's go, Larvy!"), localId=OBJ_EVENT_ID_NPC_FOLLOWER, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
        closemessage
    }
    end
}