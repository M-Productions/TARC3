{
    msgbox(format("Genetic material from an ancient flying Pokémon is encased in the amber."), MSGBOX_SIGN)
}

script JurassicPark_Visitor_Centre_EventScript_Drampa
{
    lock
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT))
    {
        case DIR_NORTH:
            break
        case DIR_EAST:
            applymovement(LOCALID_DRAMPA_CENTRE, moves(walk_in_place_left))
            waitmovement(0)
        case DIR_WEST:
            applymovement(LOCALID_DRAMPA_CENTRE, moves(walk_in_place_right))
            waitmovement(0)
    }
    if(var(VAR_GAME_STATE)==GS_CENTRE_SECOND_VISIT)
    {
        mnmbox(format("Ah, hello!\pYes, as I was saying, I have a boat ready to get you back as soon as the rain stops.\pOf course, you'll put a good word for the park before the opening, won't you?"), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
        closemessage
        release
        end
    }



    mnmbox(format("Magnificent exhibits, eh?\pSo, are you ready to learn more?"), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    closemessage
    msgbox(format("Proceed to the explanation?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO)
    {
        mnmbox(format("Of course, of course!\pFeel free to look around all you want.\nThere is no rush!"), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
        closemessage
        end
    }
    mnmbox(format("Splendid!\nNow, let us gather all of your friends."), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_JOYOUS)
    closemessage
    fadescreen(FADE_TO_BLACK)
    delay(5)
    fadenewbgm(MUS_CALM_CUTSCENE)
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    switch(var(VAR_RESULT))
    {
        case DIR_NORTH:
            break
        case DIR_EAST:
            applymovement(LOCALID_PLAYER, moves(walk_faster_down, walk_faster_right, face_up))
            waitmovement(0)
        case DIR_WEST:
            applymovement(LOCALID_PLAYER, moves(walk_faster_down, walk_faster_left, face_up))
            waitmovement(0)
    }
    setobjectxy(LOCALID_PHANPY_CENTRE, 14, 7)
    setobjectxy(LOCALID_BAGON_CENTRE, 15, 8)
    setobjectxy(LOCALID_JIGGLYPUFF_CENTRE, 14, 8)
    applymovement(LOCALID_PHANPY_CENTRE, moves(face_up))
    applymovement(LOCALID_JIGGLYPUFF_CENTRE, moves(face_up))
    applymovement(LOCALID_BAGON_CENTRE, moves(face_up))
    applymovement(LOCALID_DRAMPA_CENTRE, moves(walk_in_place_down))
    waitmovement(0)
    fadescreen(FADE_FROM_BLACK)
    mnmbox(format("So, everyone, you're familiar with prehistoric Pokémon, yes?"), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Mysterious Pokémon that existed millions of years ago and went extinct?"), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("Precisely!\pBack in the day, titanic Pokémon ruled the world through their might."), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("I'm sure a Salamence would beat a prehistoric Pokémon easily!"), localId=LOCALID_BAGON_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_HAPPY)
    mnmbox(format("Not even close, my child.\nPrehistoric Pokémon are much, much stronger than any Pokémon of today.\pSome scholars say that they were so powerful that Rayquaza, the dragon God, grew scared and summoned a meteor to smite them.\pOf course, it's merely fanciful tales.\nI prefer dealing with reality."), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("And, if I'm picking up the context clues…\pYou're telling us that prehistoric Pokémon surived on this island until today."), localId=LOCALID_JIGGLYPUFF_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    mnmbox(format("Oh, nothing of the sort.\pI brought them back."), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    mnmbox(format("What?!"), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("Yes!\nWith this machine here…\lWell, this one is a replica.\pBut with a machine like this, my life's work…\pI can bring fossilized remains back to life!"), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    mnmbox(format("That's impossible!"), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("And yet you've seen it with your very own eyes!\pI am in the final stages of setting up this island to be an educational park.\pI call it…\nJurassic PokéPark!"), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_JOYOUS)
    mnmbox(format("So… What are these Pokémon like?\pWe tried talking to them, but…"), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    mnmbox(format("…"), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_SAD)
    mnmbox(format("Well, why don't you come and take a look for yourselves?"), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_JOYOUS)
    mnmbox(format("(What was that look for…?)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("There's an observation platform east of this center.\NI'll meet you there.\pOh and…\nPlease don't take any detours.\pThe rest of the park is still being finished.\pIt's not dangerous, but someone could still get injured."), localId=LOCALID_DRAMPA_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    applymovement(LOCALID_DRAMPA_CENTRE, moves(walk_left*2, walk_down*4, walk_left*3, walk_down*4))
    waitmovement(0)
    removeobject(LOCALID_DRAMPA_CENTRE)
    playse(SE_EXIT)
    waitse
    mnmbox(format("Well, what are we waiting for?\pLet's go see it!"), localId=LOCALID_BAGON_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_BAGON_CENTRE)
    removeobject(LOCALID_JIGGLYPUFF_CENTRE)
    removeobject(LOCALID_PHANPY_CENTRE)
    delay(16)
    playse(SE_EXIT)
    waitse
    fadedefaultbgm
    setvar(VAR_GAME_STATE, GS_GOING_TO_PLATFORM)
    fadescreen(FADE_FROM_BLACK)
    release
    end
}

script JurassicPark_Visitor_Centre_EventScript_CentreSecondVisit
{
    setvar(VAR_GAME_STATE, GS_CENTRE_SECOND_VISIT)
    clearflag(FLAG_HIDE_BAGON_CENTRE)
    clearflag(FLAG_HIDE_JIGGLYPUFF_CENTRE)
    clearflag(FLAG_HIDE_DRAMPA_CENTRE)
    clearflag(FLAG_HIDE_PHANPY_CENTRE)
    setobjectxyperm(LOCALID_JIGGLYPUFF_CENTRE, 1, 5)
    setobjectxyperm(LOCALID_PHANPY_CENTRE, 2, 8)
    setobjectmovementtype(LOCALID_PHANPY_CENTRE, MOVEMENT_TYPE_FACE_DOWN)
    release
    end
}

script JurassicPark_Visitor_Centre_EventScript_LarvyPanic
{
    lock
    applymovement(LOCALID_PLAYER, moves(walk_up*6, face_down))
    waitmovement(0)
    mnmbox(format("(It's not coming inside, is it?!)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    closemessage
    delay(32)
    fadenewbgm(MUS_DUMMY)
    mnmbox(format("(No…\nI guess it's too big.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    mnmbox(format("(But, the others!\nDid they make it?!)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("(I have to find them…\nAnd restart the generators.)\p(But the only way is…\nGoing outside.)\p(Gulp…\nCan I even… Do this?)\p(…I don't have a choice.\nI need to.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    closemessage
    clearflag(FLAG_PANIC_OW_MUSIC)
    setvar(VAR_GAME_STATE, GS_NO_GENERATORS)
    release
    end
}

script JurassicPark_Visitor_Centre_EventScript_TwoGeneratorsCutsceneIndoor
{
    delay(16)
    fadescreen(FADE_FROM_BLACK)
    switch(var(VAR_FIRST_SAVED))
    {
        case CHAR_PHANPY:
        case CHAR_BAGON:
            mnmbox(format("(Will she…\nBe okay?)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
        case CHAR_JIGGLYPUFF:
            mnmbox(format("(Will he…\nBe okay?)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
    }
    switch(var(VAR_SECOND_SAVED))
    {
        case CHAR_BAGON:
            switch(var(VAR_FIRST_SAVED))
            {
                case CHAR_PHANPY:
                    mnmbox(format("I-I don't know, Larvy.\nI don't know much about medicine.\pPhanpy would know, but…\nOh, poor Phanpy…\pIf I wasn't so weak, she wouldn't have had to…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SAD)
                case CHAR_BAGON:
                    mnmbox(format("I-I don't know, Larvy.\nI don't know much about medicine.\pPhanpy would know, but she's not here right now…\pIf I wasn't so weak, Jiggly wouldn't have had to…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SAD)
            }
        case CHAR_JIGGLYPUFF:
            switch(var(VAR_FIRST_SAVED))
            {
                case CHAR_PHANPY:
                    mnmbox(format("…She will be.\nShe HAS to.\pWe've gone through so much worse together.\pThis is nothing, you understand?\nNothing!\pI can't believe she would go ahead and pull this one me…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
                case CHAR_JIGGLYPUFF:
                    mnmbox(format("…I got sloppy.\nThis is all my fault.\pI let my guard down and this…\nAnd this…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
            }
        case CHAR_PHANPY:
            switch(var(VAR_FIRST_SAVED))
            {
                case CHAR_BAGON:
                    mnmbox(format("I-I don't know…\nThere was barely any medicine here…\pOh, Bagon, why did you have to…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SAD)
                case CHAR_JIGGLYPUFF:
                    mnmbox(format("I-I don't know…\nThere was barely any medicine here…\pOh, Jiggly, I…\nIt can't end like this…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SAD)
            }
        
    }
        mnmbox(format("(This was all my fault.)\p(If there is someone to take the blame…\nIt should be me.)\p(If I didn't freeze up, I could have…\nI should have…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
        switch(var(VAR_SECOND_SAVED))
        {
            case CHAR_BAGON:
                mnmbox(format("Larvy, no!\nYou've been doing so much!\pSo much more than me.\pThis…\nWas too much for all of us.\pIt's not your fault.\pI think…\nWe have to get out of here…\lAs soon as possible."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
                switch(var(VAR_FIRST_SAVED))
                {
                    case CHAR_PHANPY:
                        mnmbox(format("(But Phanpy…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SAD)
                        mnmbox(format("I'll look after her, okay?\pI don't know if there's anything here that can make her feel better, but…\pOnce we leave the island, we can take her to a hospital.\pI think you should…\nStart looking for the final generator."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SAD)
                    case CHAR_JIGGLYPUFF:
                        mnmbox(format("(But Jiggly…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SAD)
                        mnmbox(format("I'll look after him, okay?\pI don't know if there's anything here that can make him feel better, but…\pOnce we leave the island, we can take him to a hospital.\pI think you should…\nStart looking for the final generator."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SAD)
                }
                mnmbox(format("(But if that Pokémon showed up again, I don't know if…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
                mnmbox(format("Larvy.\nI know how you feel.\pBut we need you.\nI know you can do it, okay?"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SAD)
                mnmbox(format("(You're right.\nMy friends need me.)\p(Okay.\nI will look for the last generator, now.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
                switch(var(VAR_FIRST_SAVED))
                {
                    case CHAR_PHANPY:
                        mnmbox(format("Thank you.\nI promise, Phanpy will be okay."), localId=VAR_LOCALID_CUTSCENE_MAIN)
                    case CHAR_JIGGLYPUFF:
                        mnmbox(format("Thank you.\nI promise, Jiggly will be okay."), localId=VAR_LOCALID_CUTSCENE_MAIN)
                }
            case CHAR_JIGGLYPUFF:
                mnmbox(format("Oh no no no, don't you start.\pDon't you START blaming yourself.\pDon't you know how egoistical that is?\nIt drives me insane."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
                mnmbox(format("(You were JUST blaming yourself.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
                mnmbox(format("Oh, I know that look.\nYou're thinking I'm a hypocrite."), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
                mnmbox(format("…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_TEARY_EYED)
                switch(var(VAR_FIRST_SAVED))
                {
                    case CHAR_PHANPY:
                        mnmbox(format("I know, okay?\nI know I am!\pI drive myself insane!\pI'm just-\nI'm just-\pI'm just trying to keep everything running!\pAnd I didn't, and now Phanpy…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_CRYING)
                    case CHAR_BAGON:
                        mnmbox(format("I know, okay?\nI know I am!\pI drive myself insane!\pI'm just-\nI'm just-\pI'm just trying to keep everything running!\pAnd I didn't, and now Phanpy…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_CRYING)
                }
                mnmbox(format("(Jiggly…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SAD)
                mnmbox(format("…I don't know if there's anything here that can help with the wounds.\pLarvy, could you…\nTry and find the last generator…?\NWe need to leave.\pI want to…\nStay here and make sure that…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_TEARY_EYED)
                mnmbox(format("(…I understand.\pI don't know what I'll do if that Pokémon shows up again, but…\pI will try.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
            case CHAR_PHANPY:
                mnmbox(format("No, Larvy, please.\nDon't blame yourself.\pThis adventure was my idea.\nI'm the one who pushed for it.\pI thought it was going to be easy.\nI thought it was going to be fun.\pI thought we were going to make amazing discoveries.\pAnd instead…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
                mnmbox(format("(You didn't know…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SAD)
                mnmbox(format("Of COURSE I didn't know, did I?!\pThat's the problem!\nThat's always the problem!\pPeople rely on me to know everything!\nAnd when I don't…\NAnd when I don't…!\pPokémon get hurt!\nOr…\NWorse…"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
                mnmbox(format("(Phanpy…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_TEARY_EYED)
                mnmbox(format("I-I'm sorry.\pI-I'd like to stay here.\nSee what I can do.\pCould you look for the last generator…?"), localId=VAR_LOCALID_CUTSCENE_MAIN, mugshotEmotion=MUGSHOT_EMOTE_TEARY_EYED)
                mnmbox(format("(…I understand.\pI don't know what I'll do if that Pokémon shows up again, but…\pI will try.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)

        }
        setvar(VAR_GAME_STATE, GS_POST_TWO_GENERATORS)
        clearflag(FLAG_NO_OW_MUSIC)
        clearflag(FLAG_SPAWN_WEST)
        destroyfollowernpc
        forcesave
        releaseall
        end
}