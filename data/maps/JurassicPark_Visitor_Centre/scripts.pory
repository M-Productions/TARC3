mapscripts JurassicPark_Visitor_Centre_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        switch(var(VAR_GAME_STATE))
        {
            case GS_DRAMPA_EXPLAINER:
                goto(JurassicPark_Visitor_Centre_EventScript_CentreSecondVisit)
                
            default:
                end
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_GAME_STATE, GS_MET_DRAMPA {
            goto(JurassicPark_Visitor_Centre_EventScript_LookLarvy)
        }
        VAR_GAME_STATE, GS_CENTRE_AFTER_BRIDGE {
            
            goto(JurassicPark_Visitor_Centre_EventScript_LarvyPanic)
        }
    ]
    
}


script JurassicPark_Visitor_Centre_EventScript_LookLarvy
{
    lock
    msgbox(format("Larvy!\nCome here!\pThis is incredible!"))
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_up*5))
    waitmovement(0)
    setvar(VAR_GAME_STATE, GS_IN_CENTRE)
    release
    end
}

script JurassicPark_Visitor_Centre_EventScript_WalkUp
{
    lock
    mnmbox(format("(I need to talk to people first.)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_NORMAL)
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_up))
    waitmovement(0)
    end
}

script JurassicPark_Visitor_Centre_EventScript_Bagon
{
    lock
    switch(var(VAR_GAME_STATE))
    {
        case GS_IN_CENTRE:
            faceplayer
            mnmbox(format("Look at how big this guy is!\pWill I grow up to be this strong, too?"), localId=LOCALID_BAGON_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_INSPIRED)
            closemessage
        case GS_CENTRE_SECOND_VISIT:
            faceplayer
            mnmbox(format("Now that I've met a real one, this skeleton is kind of scary."), localId=LOCALID_BAGON_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
            closemessage
    }
    release
    end
}

script JurassicPark_Visitor_Centre_EventScript_Phanpy
{
    lock
    switch(var(VAR_GAME_STATE))
    {
        case GS_IN_CENTRE:
            faceplayer
            mnmbox(format("So it WAS prehistoric Pokémon…\nBut… How?"), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
            closemessage
        case GS_CENTRE_SECOND_VISIT:
            faceplayer
            mnmbox(format("Hey, Larvy…\nDo you have time?\pThere's something I have to talk you about."), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
            closemessage
            msgbox(format("Listen to what Phanpy has to say?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == NO){
                mnmbox(format("Of course.\nTake you time!"), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
                closemessage
                release
                end
            }
            mnmbox(format("So, uhm…\nAbout this… Park.\pDon't you think it's a bit…\nStrange?\pI'm not sure how to feel about the caged Pokémon.\pThey may be mindless as Dr. Drampa said, but…\NThey're still Pokémon.\pAnd exhibiting them in enclosures…\nI'm not sure about it."), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_SAD)
            applymovement(LOCALID_JIGGLYPUFF_CENTRE, moves(face_down))
            mnmbox(format("What's strange here is the power grid.\pThe Doc wasn't lying about the backup generators.\pBut if I'm reading this right, the system is way overloaded.\pSomething is pulling an immense quantity of power."), localId=LOCALID_JIGGLYPUFF_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
            mnmbox(format("Which means…?"), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
            mnmbox(format("Which means that in case of any power fluctuation…\NSay, from a lightning strike…\pThe whole thing would go down."), localId=LOCALID_JIGGLYPUFF_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
            mnmbox(format("That's…\pSurely there's safeguards in place…\NRight?"), localId=LOCALID_PHANPY_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_PAIN)
            closemessage
            playse(SE_THUNDER)
            waitse
            getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
            clearflag(FLAG_MUSIC_RAIN)
            fadescreen(FADE_TO_BLACK)
            delay(32)
            warpsilent(MAP_JURASSIC_PARK_VISITOR_CENTRE_RED, VAR_TEMP_1, VAR_TEMP_2)
            waitstate

    }
    release
    end
}

script JurassicPark_Visitor_Centre_EventScript_Jigglypuff
{
    lock
    switch(var(VAR_GAME_STATE))
    {
        case GS_IN_CENTRE:
            mnmbox(format("This face…\nIts smug aura mocks me."), localId=LOCALID_JIGGLYPUFF_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_ANGRY)
            closemessage
        case GS_CENTRE_SECOND_VISIT:
            mnmbox(format("Is that so…"), localId=LOCALID_JIGGLYPUFF_CENTRE, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
            closemessage

    }
    release
    end
}


