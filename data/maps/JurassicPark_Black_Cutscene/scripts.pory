mapscripts JurassicPark_Black_Cutscene_MapScripts {

    MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_INTRO_BOAT_CUTSCENE, 0: Black_Cutscene_Boat_Intro
    ]
}


script Black_Cutscene_Boat_Intro{
    lockall
    playse(SE_THUNDERSTORM)
    delay(20)
    msgbox(format("Somewhere, in the deep ocean…"))
    closemessage
    playse(SE_THUNDER)
    waitse
    delay(5)
    playse(SE_THUNDER2)
    waitse
    mnmbox(format("A-are you okay, everyone?!"), localId=LOCALID_PHANPY, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    playse(SE_THUNDER)
    mnmbox(format("(Urgh…\nI think I'm going to be sick…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_DIZZY)
    mnmbox(format("You and your treasure maps!\pThere was supposed to be land, here!\nLand!"), localId=LOCALID_JIGGLYPUFF, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    mnmbox(format("W-we just got a little off course, is all!"), localId=LOCALID_PHANPY, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
    mnmbox(format("A little off course."), localId=LOCALID_JIGGLYPUFF, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("(Here we go again…)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SIGH)
    closemessage
    delay(10)
    playse(SE_THUNDER2)
    waitse
    delay(10)
    mnmbox(format("Erm, guys…?"), localId=LOCALID_BAGON, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("I'm sure we'll find the island!\pWe have to be very close, now!"), localId=LOCALID_PHANPY, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("If we don't get thrown overboard first, that is!"), localId=LOCALID_JIGGLYPUFF, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    mnmbox(format("GUYS!\pLook, over there!\nIsn't that…?"), localId=LOCALID_BAGON, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Look at w-"), localId=LOCALID_JIGGLYPUFF, mugshotEmotion=MUGSHOT_EMOTE_WORRIED)
    mnmbox(format("Oh.\nOh, no."), localId=LOCALID_JIGGLYPUFF, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    closemessage
    delay(10)
    playse(SE_THUNDER)
    waitse
    delay(10)
    mnmbox(format("(That wave…\nIt's awfully big, isn't it…?)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("Turn the ship around!\nNOW!\pWe have to face it dead on!"), localId=LOCALID_PHANPY, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
    mnmbox(format("On it!"), localId=LOCALID_JIGGLYPUFF, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    mnmbox(format("We're gonna die!\nWe're gonna die!"), localId=LOCALID_BAGON, mugshotEmotion=MUGSHOT_EMOTE_CRYING)
    mnmbox(format("We're not gonna die if you just GIVE US A HAND!"), localId=LOCALID_JIGGLYPUFF, mugshotEmotion=MUGSHOT_EMOTE_DETERMINED)
    mnmbox(format("(No! It's too late!\NIt's already here!)"), localId=LOCALID_PLAYER, mugshotEmotion=MUGSHOT_EMOTE_STUNNED)
    mnmbox(format("Everyone!\nBrace for impact!"), localId=LOCALID_PHANPY, mugshotEmotion=MUGSHOT_EMOTE_SHOUTING)
    mnmbox(format("A{PAUSE 10}h{PAUSE 10}h{PAUSE 10}h{PAUSE 10}h{PAUSE 10}h{PAUSE 10}h{PAUSE 10}h{PAUSE 10}h{PAUSE 10}!"), localId=LOCALID_JIGGLYPUFF, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    mnmbox(format("N{PAUSE 10}o{PAUSE 10}o{PAUSE 10}o{PAUSE 10}o{PAUSE 10}o{PAUSE 10}o{PAUSE 10}o{PAUSE 10}o{PAUSE 10}!"), localId=LOCALID_BAGON, mugshotEmotion=MUGSHOT_EMOTE_SURPRISED)
    closemessage
    delay(5)
    playse(SE_THUNDER2)
    waitse
    delay(5)
    playse(SE_M_HYDRO_PUMP)
    waitse
    playse(SE_M_EXPLOSION)
    waitse
    delay(30)
    setvar(VAR_INTRO_BOAT_CUTSCENE, 1)
    warpsilent(MAP_JURASSIC_PARK_BEACH_DOCKS, 0)



}